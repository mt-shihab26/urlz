{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "bun vercel-install",
	"buildCommand": "bun vercel-build",
	"outputDirectory": "web/dist",
	"regions": ["bom1"],
	"git": {
		"deploymentEnabled": {
			"main": true
		}
	},
	"functions": {
		"api/proxy.ts": {
			"includeFiles": "dist/main",
			"maxDuration": 30
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api/proxy"
		}
	],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
