<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>404 — urlz</title>
    </head>
    <body
        style="
            margin: 0;
            background: #09090b;
            color: #fafafa;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: flex;
            min-height: 100svh;
            align-items: center;
            justify-content: center;
        "
    >
        <div
            style="
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 1.5rem;
                text-align: center;
                padding: 2rem;
            "
        >
            <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem">
                <span
                    style="
                        font-size: 6rem;
                        font-weight: 700;
                        letter-spacing: -0.05em;
                        color: #71717a;
                        opacity: 0.3;
                        line-height: 1;
                    "
                    >404</span
                >
                <h1 style="margin: 0; font-size: 1.5rem; font-weight: 600">{{.Message}}</h1>
                <p style="margin: 0; font-size: 0.875rem; color: #71717a">
                    This link doesn't exist, has been disabled, or has expired.
                </p>
            </div>
            <a
                href="/dashboard/overview"
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    height: 2.25rem;
                    padding: 0 1rem;
                    border-radius: 0.375rem;
                    background: #fafafa;
                    color: #09090b;
                    font-size: 0.875rem;
                    font-weight: 500;
                    text-decoration: none;
                "
                >Go home</a
            >
        </div>
    </body>
</html>
